{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": ["src/index.ts!", "src/**/*.ts!"],
  "ignoreDependencies": [
    // Loaded dynamically by markdownlint-cli2 via customRules in
    // .markdownlint-cli2.jsonc — Knip can't see that reference.
    "sentences-per-line",
    // Loaded dynamically as string specifiers in vite.config.ts `jsPlugins`
    // (Vite+/oxlint integration) — Knip can't see those references.
    "eslint-plugin-jsonc",
    "eslint-plugin-no-only-tests",
    "eslint-plugin-perfectionist",
    "eslint-plugin-regexp",
    "eslint-plugin-yml",
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  "project": "src/**/*.ts!",
}
