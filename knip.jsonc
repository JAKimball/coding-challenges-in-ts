{
  "$schema": "https://unpkg.com/knip/schema.json",
  "entry": ["src/index.ts!"],
  "ignoreBinaries": ["dedupe", "gh"],
  "ignoreDependencies": [
    // TODO: investigate if these are still flagged, and file issues if not
    "all-contributors-cli",
    "c8",
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true,
  },
  "project": "src/**/*.ts!",
}
