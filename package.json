{
  "name": "coding-challenges-in-ts",
  "version": "0.0.0",
  "description": "A repo for code practice and challenges in TypeScript",
  "repository": {
    "type": "git",
    "url": "https://github.com/JAKimball/coding-challenges-in-ts"
  },
  "license": "MIT",
  "author": {
    "name": "Jonathan Kimball",
    "email": "new.cat5598@jonathankimball.dev"
  },
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "bin/",
    "lib/",
    "package.json",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "devtest": "vitest --ui --open --api.port 32250",
    "format": "prettier \"**/*\" --ignore-unknown",
    "format:write": "pnpm format --write",
    "lint": "eslint . .*js --max-warnings 0 --report-unused-disable-directives",
    "lint:knip": "knip",
    "lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules sentences-per-line",
    "lint:package": "npmPkgJsonLint .",
    "lint:packages": "pnpm dedupe --check",
    "lint:spelling": "cspell \"**\" \".github/**/*\"",
    "prepare": "husky",
    "should-semantic-release": "should-semantic-release --verbose",
    "test": "vitest"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.10",
    "console-fail-test": "^0.4.4",
    "cspell": "^8.19.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^3.9.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-yml": "^1.19.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.4.2",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "markdownlint": "^0.34.0",
    "markdownlint-cli": "^0.41.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^2.5.22",
    "sentences-per-line": "^0.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "yaml-eslint-parser": "^1.3.2"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "provenance": true
  }
}
