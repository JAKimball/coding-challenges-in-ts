{
  "name": "coding-challenges-in-ts",
  "version": "0.0.0",
  "description": "A repo for code practice and challenges in TypeScript",
  "license": "MIT",
  "author": {
    "name": "Jonathan Kimball",
    "email": "new.cat5598@jonathankimball.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JAKimball/coding-challenges-in-ts"
  },
  "files": [
    "bin/",
    "lib/",
    "package.json",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "devtest": "vp test watch --ui --open --api.port 32250 --api.strictPort",
    "format": "vp fmt \"**/*\"",
    "format:write": "pnpm format --write",
    "lint": "vp lint . --max-warnings 0 --report-unused-disable-directives",
    "lint:knip": "knip",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \".github/**/*.md\"",
    "lint:packages": "pnpm dedupe --check",
    "lint:spelling": "cspell \"**\" \".github/**/*\"",
    "prepare": "vp config --no-agent",
    "tsc": "tsc --noEmit",
    "test": "vp test"
  },
  "dependencies": {
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "console-fail-test": "^0.4.4",
    "cspell": "^8.19.4",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^3.9.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-yml": "^1.19.1",
    "knip": "^5.88.1",
    "markdownlint-cli2": "^0.23.2",
    "sentences-per-line": "^0.2.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
