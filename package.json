{
  "name": "coding-challenges-in-ts",
  "version": "0.0.0",
  "description": "A repo for code practice and challenges in TypeScript",
  "license": "MIT",
  "author": {
    "name": "Jonathan Kimball",
    "email": "new.cat5598@jonathankimball.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JAKimball/coding-challenges-in-ts"
  },
  "files": [
    "bin/",
    "lib/",
    "package.json",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "devtest": "vp test --ui --open --api.port 32250",
    "format": "vp fmt \"**/*\"",
    "format:write": "pnpm format --write",
    "lint": "vp lint . --max-warnings 0 --report-unused-disable-directives",
    "lint:knip": "knip",
    "lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules sentences-per-line",
    "lint:packages": "pnpm dedupe --check",
    "lint:spelling": "cspell \"**\" \".github/**/*\"",
    "prepare": "husky",
    "test": "vp test"
  },
  "dependencies": {
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-istanbul": "catalog:",
    "@vitest/ui": "catalog:",
    "console-fail-test": "^0.4.4",
    "cspell": "^8.19.4",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^3.9.1",
    "eslint-plugin-regexp": "^2.10.0",
    "eslint-plugin-yml": "^1.19.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.4.2",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "markdownlint": "^0.34.0",
    "markdownlint-cli": "^0.41.0",
    "sentences-per-line": "^0.2.2",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml-eslint-parser": "^1.3.2"
  },
  "lint-staged": {
    "*": "vp fmt"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
