{
  "config": {
    "extends": "markdownlint/style/prettier",
    "first-line-h1": false,
    "no-inline-html": false,
    "sentences-per-line": true,
  },
  "customRules": ["sentences-per-line"],
  "ignores": [
    ".github/CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "lib",
    "node_modules",
    "src/aoc/**/README.md",
    "src/text/sample.md",
  ],
}
